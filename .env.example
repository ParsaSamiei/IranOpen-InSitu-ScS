# Neon / Vercel Postgres connection string (required for local API)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret used to sign login tokens (required — without it the API rejects all
# login attempts). Any long random string; rotate it to invalidate all
# existing sessions.
AUTH_SECRET=choose-a-long-random-string

# Bootstrap Super Admin: on first startup (when no super_admin account exists
# yet), the app creates one from these env vars, then no-ops on every startup
# after that. Self-heals if the DB is ever recreated. Once you've logged in
# and created other accounts from the Users admin screen, you can rotate this
# password without affecting existing sessions.
BOOTSTRAP_SUPERADMIN_USERNAME=admin
BOOTSTRAP_SUPERADMIN_PASSWORD=choose-a-strong-password

# ---- Login rate limiting (all optional; defaults shown) ----
# Failed logins only — a successful login costs nothing and clears that
# username's counter.
#   ..._MAX_PER_IP   blunt per-address cap. Keep it generous: a whole venue
#                    usually shares one public IP, so a tight limit locks out
#                    every judge at once.
#   ..._MAX_PER_USER the real brute-force protection, per account, so rotating
#                    IPs doesn't help an attacker.
# Set either to 0 to disable that limiter (emergency escape hatch during a
# live competition — restart required).
# LOGIN_RATE_LIMIT_WINDOW_MS=600000
# LOGIN_RATE_LIMIT_MAX_PER_IP=30
# LOGIN_RATE_LIMIT_MAX_PER_USER=8

# Number of reverse proxies in front of the app. Defaults to 1, which is right
# when nginx proxies to this process (the documented deployment) and is what
# makes the per-IP limit key on the real client address. Set to 0 only if the
# app is exposed directly with no proxy in front of it.
# TRUST_PROXY=1
