# Copy this to /opt/IranOpen-InSitu/.env on the server and fill in real values.
# This file itself (with real values) must NEVER be committed to git.
POSTGRES_USER=IranOpen-InSitu
POSTGRES_PASSWORD=change_me_to_a_long_random_password
POSTGRES_DB=IranOpen-InSitu

AUTH_SECRET=choose-a-long-random-string
BOOTSTRAP_SUPERADMIN_USERNAME=admin
BOOTSTRAP_SUPERADMIN_PASSWORD=choose-a-strong-password
